<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#111111"><link rel="canonical" href="{{ canonical_url }}">{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<title>{% if page_title %}{{ page_title }}{% else %}CRABYX{% endif %}</title>{{ content_for_header }}{{ 'crabyx.css' | asset_url | stylesheet_tag }}</head><body class="template-{{ template.name | handle }}">{% section 'announcement-bar' %}<header class="site-header"><a class="logo" href="{{ routes.root_url }}" aria-label="CRABYX home">CRABYX</a><button class="mobile-menu-btn" type="button" data-menu-toggle aria-label="Open menu">☰</button><nav class="desktop-nav" aria-label="Main navigation"><a href="{{ routes.root_url }}">Home</a><div class="mega-parent"><a href="/collections/all">Shop</a><div class="mega-menu">{% for collection in collections limit: 8 %}<a href="{{ collection.url }}">{{ collection.title }}</a>{% endfor %}</div></div><a href="/pages/about">About</a><a href="/pages/contact">Contact</a></nav><div class="header-actions"><a href="{{ routes.search_url }}" aria-label="Search">⌕</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account">Account</a>{% endif %}<button type="button" class="cart-trigger" data-cart-open aria-label="Open cart">Cart <span id="cart-count">{{ cart.item_count }}</span></button></div></header><nav class="mobile-menu" data-mobile-menu aria-hidden="true"><a href="{{ routes.root_url }}">Home</a><a href="/collections/all">Shop</a><a href="/pages/about">About</a><a href="/pages/contact">Contact</a><a href="/pages/report-issue">Report issue</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Account</a>{% endif %}</nav><main id="MainContent" role="main">{{ content_for_layout }}</main>{% render 'cart-drawer' %}<nav class="mobile-bottom-nav" aria-label="Mobile navigation"><a href="{{ routes.root_url }}">⌂<span>Home</span></a><a href="{{ routes.search_url }}">⌕<span>Search</span></a><button type="button" data-cart-open>🛒<span>Cart</span><b id="mobile-cart-count">{{ cart.item_count }}</b></button>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">♙<span>Account</span></a>{% else %}<a href="/pages/contact">✉<span>Help</span></a>{% endif %}</nav><footer class="site-footer"><div class="footer-grid"><div><div class="logo">CRABYX</div><p>Everyday products, picked better.</p></div><div><h3>Explore</h3><a href="/collections/all">Shop all</a><a href="/pages/about">About</a></div><div><h3>Help</h3><a href="/pages/contact">Contact</a><a href="/pages/report-issue">Report an issue</a></div></div><div class="footer-bottom">© {{ 'now' | date: '%Y' }} CRABYX. All rights reserved.</div></footer>{{ 'crabyx.js' | asset_url | script_tag }}</body></html>