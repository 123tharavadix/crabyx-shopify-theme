<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#111111">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title %}{{ page_title }}{% else %}CRABYX{% endif %}</title>
  {{ content_for_header }}
  {{ 'crabyx.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ template.name | handle }}">
  {% section 'announcement-bar' %}
  <header class="site-header">
    <a class="logo" href="{{ routes.root_url }}" aria-label="CRABYX home">CRABYX</a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/collections/all">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/contact">Contact</a>
    </nav>
    <div class="header-actions">
      <a href="{{ routes.search_url }}" aria-label="Search">⌕</a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">Cart <span id="cart-count">{{ cart.item_count }}</span></a>
    </div>
  </header>

  <main id="MainContent" role="main">{{ content_for_layout }}</main>

  <footer class="site-footer">
    <div class="footer-grid">
      <div><div class="logo">CRABYX</div><p>Everyday products, picked better.</p></div>
      <div><h3>Explore</h3><a href="/collections/all">Shop all</a><a href="/pages/about">About</a></div>
      <div><h3>Help</h3><a href="/pages/contact">Contact</a><a href="/pages/report-issue">Report an issue</a></div>
    </div>
    <div class="footer-bottom">© {{ 'now' | date: '%Y' }} CRABYX. All rights reserved.</div>
  </footer>
  {{ 'crabyx.js' | asset_url | script_tag }}
</body>
</html>