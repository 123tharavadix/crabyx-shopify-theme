<section class="section"><div class="content-narrow"><p>CRABYX</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p>{% form 'contact', class: 'contact-form' %}<label>Name<input type="text" name="contact[name]" required autocomplete="name"></label><label>Email<input type="email" name="contact[email]" required autocomplete="email"></label><label>Message<textarea name="contact[body]" rows="7" required></textarea></label><button class="btn" type="submit">Send message</button>{% if form.posted_successfully? %}<p>Thanks — your message has been sent.</p>{% endif %}{% if form.errors %}{{ form.errors | default_errors }}{% endif %}{% endform %}</div></section>{% schema %}{"name":"Contact form","settings":[{"type":"text","id":"heading","label":"Heading","default":"Contact CRABYX"},{"type":"textarea","id":"intro","label":"Intro","default":"Questions about an order or product? Send us a message."}],"presets":[{"name":"Contact form"}]}{% endschema %}