<section class="section newsletter"><div><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email address</label><input id="NewsletterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="you@example.com" required autocomplete="email"><button class="btn" type="submit">{{ section.settings.button }}</button>{% if form.posted_successfully? %}<p>Thanks for joining CRABYX.</p>{% endif %}{% if form.errors %}{{ form.errors | default_errors }}{% endif %}{% endform %}</section>{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"STAY IN THE LOOP"},{"type":"text","id":"heading","label":"Heading","default":"New drops. Better picks."},{"type":"textarea","id":"text","label":"Text","default":"Get product updates and offers from CRABYX."},{"type":"text","id":"button","label":"Button","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}{% endschema %}