<section class="section"><div class="content-narrow"><p>SUPPORT</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p>{% form 'contact', class: 'contact-form' %}<input type="hidden" name="contact[subject]" value="CRABYX Website Issue"><label>Order number (optional)<input type="text" name="contact[order_number"></label><label>Email<input type="email" name="contact[email]" required autocomplete="email"></label><label>Issue<textarea name="contact[body]" rows="8" required placeholder="Tell us what went wrong..."></textarea></label><button class="btn" type="submit">Report issue</button>{% if form.posted_successfully? %}<p>Your report has been received.</p>{% endif %}{% if form.errors %}{{ form.errors | default_errors }}{% endif %}{% endform %}</div></section>{% schema %}{"name":"Report issue","settings":[{"type":"text","id":"heading","label":"Heading","default":"Report an issue"},{"type":"textarea","id":"intro","label":"Intro","default":"Help us improve CRABYX by telling us what went wrong."}],"presets":[{"name":"Report issue"}]}{% endschema %}