<section class="hero"><div><p>{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.button_label != blank %}<a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}</div></section>
{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WELCOME TO CRABYX"},{"type":"text","id":"heading","label":"Heading","default":"SHOP BETTER. LIVE BETTER."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Discover products worth adding to your everyday."},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Hero"}]}{% endschema %}