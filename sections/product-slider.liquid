<section class="section product-slider-section" data-slider>
  <div class="section-head"><div><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><div class="slider-controls"><button type="button" data-slider-prev aria-label="Previous">←</button><button type="button" data-slider-next aria-label="Next">→</button></div></div>
  <div class="product-slider" data-slider-track>
    {% assign collection = section.settings.collection %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      <p>Select a collection in the Theme Editor.</p>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Product slider","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TRENDING NOW"},{"type":"text","id":"heading","label":"Heading","default":"Customer favourites"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":4,"max":12,"step":1,"default":8}],"presets":[{"name":"Product slider"}]}{% endschema %}