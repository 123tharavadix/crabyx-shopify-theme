<section class="section"><div class="section-head"><div><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div><a href="/collections/all">View all →</a></div>{% assign collection=section.settings.collection %}<div class="product-grid">{% for product in collection.products limit: section.settings.products_to_show %}<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<h3>{{ product.title }}</h3><div class="price">{{ product.price | money }}</div></a></article>{% else %}<p>Add products to the selected collection in Shopify admin.</p>{% endfor %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"CRABYX PICKS"},{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":12,"step":1,"default":8}],"presets":[{"name":"Featured products"}]}{% endschema %}