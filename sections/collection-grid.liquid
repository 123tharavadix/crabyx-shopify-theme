<section class="section"><div class="section-head"><div><p>{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></div><div class="collection-grid">{% for collection in collections limit: section.settings.limit %}<a class="collection-card" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}<div><h3>{{ collection.title }}</h3><span>{{ collection.all_products_count }} products</span></div></a>{% endfor %}</div></section>{% schema %}{"name":"Collection grid","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP BY CATEGORY"},{"type":"text","id":"heading","label":"Heading","default":"Find your next favourite"},{"type":"range","id":"limit","label":"Collections","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Collection grid"}]}{% endschema %}