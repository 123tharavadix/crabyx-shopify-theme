<section class="section product-section"><div class="product-layout"><div class="product-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: product.featured_image.alt | default: product.title }}{% endif %}</div><div class="product-info"><p class="eyebrow">CRABYX</p><h1>{{ product.title }}</h1><div class="product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>{% if product.description != blank %}<div class="product-description">{{ product.description }}</div>{% endif %}{% form 'product', product, id: 'product-form' %}<select name="id" id="ProductSelect" class="variant-select" aria-label="Choose a variant">{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><div class="quantity-row"><label for="Quantity">Quantity</label><div class="quantity-control"><button type="button" data-qty-minus aria-label="Decrease quantity">−</button><input id="Quantity" name="quantity" type="number" min="1" value="1" inputmode="numeric"><button type="button" data-qty-plus aria-label="Increase quantity">+</button></div></div><button class="btn btn--wide" type="submit" name="add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}<button class="wishlist-btn" type="button" data-wishlist data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">♡ <span>Add to wishlist</span></button><div class="product-meta"><span>Secure Shopify checkout</span><span>Fast support</span></div></div></div></section>