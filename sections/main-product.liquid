<section class="section"><div class="product-layout"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: alt: product.title }}{% endif %}</div><div><h1>{{ product.title }}</h1><p class="price">{{ product.price | money }}</p>{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><label for="Quantity">Quantity</label><input id="Quantity" name="quantity" type="number" min="1" value="1"><button class="btn" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}<div>{{ product.description }}</div></div></div></section>