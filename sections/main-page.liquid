<section class="section"><div class="page-width">{% if section.settings.show_title %}<h1>{{ page.title }}</h1>{% endif %}<div>{{ page.content }}</div></div></section>
{% schema %}{"name":"Page","settings":[{"type":"checkbox","id":"show_title","label":"Show title","default":true}],"presets":[{"name":"Page"}]}{% endschema %}