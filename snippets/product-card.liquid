<article class="product-card reveal"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{% else %}<div class="product-placeholder"></div>{% endif %}<h3>{{ product.title }}</h3></a><div class="price">{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s> {% endif %}{{ product.price | money }}</div>{% unless product.available %}<span class="sold-out">Sold out</span>{% endunless %}</article>